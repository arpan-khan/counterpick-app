<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="288dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_panel_bg"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CounterPick"
            android:textColor="#EEF1F6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_collapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="–"
            android:textColor="#EEF1F6"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/panel_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#EEF1F6"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Enemy slots -->
    <LinearLayout
        android:id="@+id/enemy_slot_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center" />
    <!-- 5 slot TextViews (enemy_slot_0..4) are added programmatically in
         OverlayService so we can reuse one inflated layout per slot cleanly. -->

    <Button
        android:id="@+id/find_best_picks_button"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:text="Find best picks"
        android:textAllCaps="false"
        android:textSize="12sp"
        android:backgroundTint="#FFB238"
        android:textColor="#191308" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ROLE"
        android:textColor="#8891A3"
        android:textSize="9sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/role_filter_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="LANE"
        android:textColor="#8891A3"
        android:textSize="9sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/lane_filter_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Swappable content: either the results list or the hero-search picker -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp">

        <ScrollView
            android:id="@+id/results_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/results_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/from_lists_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="From your lists"
                    android:textColor="#EEF1F6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/from_lists_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/picker_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/picker_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search hero"
                android:textColorHint="#8891A3"
                android:textColor="#EEF1F6"
                android:textSize="13sp"
                android:inputType="text"
                android:singleLine="true"
                android:background="@drawable/overlay_row_bg"
                android:padding="8dp" />

            <ListView
                android:id="@+id/picker_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:divider="@null"
                android:dividerHeight="4dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/empty_state_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Add enemies above, then tap Find best picks."
        android:textColor="#8891A3"
        android:textSize="11.5sp" />

</LinearLayout>
